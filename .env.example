# =============================================================
# AccessAble AI — Environment Variables Template
# BYTEATHON 2026 Problem Statement 3: The Invisible Barrier
# =============================================================
# Copy this file to create your local environment:
#   cp .env.example frontend/.env.local
#
# NEVER commit .env / .env.local with production credentials.

# --- Application Configuration ---
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ACCESSABLE_API_URL=http://localhost:3000

# --- Scanner & Journey Engine ---
PLAYWRIGHT_HEADLESS=true
TARGET_URL=http://localhost:3000/demo
# Comma-separated list of exact allowed hostnames for public read-only scanning (empty by default)
SCAN_ALLOWLIST=

# --- Automation & CI/CD Security ---
# Header x-api-key required when calling /api/automation/webhook
AUTOMATION_API_KEY=
# HMAC-SHA256 secret for signing fix receipts (optional; receipts are marked unsigned if empty)
RECEIPT_SIGNING_SECRET=

# --- Optional AI Assist (Disabled by default) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Optional n8n & Alert Gateways ---
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# GITHUB_TOKEN=
