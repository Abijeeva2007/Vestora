# =============================================================
# AccessAble AI — Environment Variables Template
# BYTEATHON 2026 Problem Statement 3: The Invisible Barrier
# =============================================================
# Copy this file to create your local environment:
#   cp .env.example frontend/.env.local
#
# NEVER commit .env / .env.local with production credentials.

# --- Application Configuration ---
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ACCESSABLE_API_URL=http://localhost:3000

# --- Scanner & Journey Engine ---
PLAYWRIGHT_HEADLESS=true
TARGET_URL=http://localhost:3000/demo

# --- n8n Webhook & CI/CD Gate Integration ---
# Optional: Set this secret to enforce HMAC/Bearer authorization on /api/automation/webhook
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
# Optional: Target webhook URL on your n8n instance
N8N_WEBHOOK_URL=http://localhost:5678/webhook/accessable-pr-check

# --- Optional Alert Gateways ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# GITHUB_TOKEN=ghp_...
