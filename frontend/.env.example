# =============================================================
# AccessAble AI — Frontend Environment Variables
# =============================================================
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
ACCESSABLE_API_URL=http://localhost:3000

# Scanner target configuration
TARGET_URL=http://localhost:3000/demo

# Automation & CI/CD Security
AUTOMATION_API_KEY=
RECEIPT_SIGNING_SECRET=

# Optional AI Assist (Disabled by default)
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# n8n Automation & Webhook Security
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL=
